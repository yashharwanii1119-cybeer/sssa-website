PORT=5000
NODE_ENV=development

# ==============================================================================
# NEON POSTGRESQL DATABASE CONFIGURATION (sssa-production / neondb)
# ==============================================================================
# 1. Pooled Connection (Used by running Express application & Prisma Client queries)
# Format: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Direct Connection (Used by Prisma for migrations, schema pushes & DDL operations)
# Format: postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Secret key for signing and verifying JWT tokens (Use a secure 64+ char random string in production)
JWT_SECRET="super-secret-jwt-token-key-for-sssa-admin"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# PERSISTENT IMAGE STORAGE (Cloudinary)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==============================================================================
# CORS ORIGINS (Whitelisted frontend domains)
# ==============================================================================
CLIENT_ORIGIN="http://localhost:5173,https://yashharwanii1119-cybeer.github.io"
ADMIN_ORIGIN="http://localhost:5174,https://admin.shreeshivshaktiart.com"
